# 部署敏感配置模板 → 复制为 .env 使用(cp .env.example .env)
# ⚠️ .env 已加入 .gitignore,不会被提交;真实密钥只存在服务器本地
# docker compose 会自动读取同目录 .env,替换 docker-compose.yml 里的 ${DB_PASSWORD} / ${JWT_SECRET}

# ── 数据库密码 ──
DB_PASSWORD=yiyu_test_2026

# ── JWT 密钥 ──
# 登录 token 用它签名;泄露即可伪造任意用户登录态。
# 生产必须改成无规律的随机长串(服务器上可执行:openssl rand -hex 32)
JWT_SECRET=请改成一段没有规律的随机长字符串

# ── Gitee WebHook 签名密钥 ──
# Gitee 仓库「管理 → WebHooks」新建钩子时,「密码」栏填这里同样的值;
# Gitee 每次 push 回调会带 X-Gitee-Token 头,webhook 服务据此拒绝伪造请求。
# 服务器上生成:openssl rand -hex 16
WEBHOOK_SECRET=
