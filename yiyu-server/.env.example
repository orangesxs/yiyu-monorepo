# 服务
PORT=3000

# 数据库(拆分配置;DATABASE_URL 由下列五项拼接,改地址/账号/密码只需改对应项)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=yiyu
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT 密钥(生产必须改成长随机串)
JWT_SECRET="change-me-in-production"
# Token 有效期
JWT_EXPIRES="7d"

# 每用户未使用邀请码上限(管理员不受限)
INVITE_MAX_UNUSED=5
